# ===== Konfigurasi Bot Telegram KonterKuota =====
# Salin file ini menjadi .env lalu isi nilainya.

# Token bot Telegram dari @BotFather
TELEGRAM_BOT_TOKEN=

# Cookie session konterkuota.com (dari header Cookie saat sudah login di browser).
# Pisahkan dengan "; ". Contoh:
# save_browser=xxx; user_id=xxx; user_key=xxx; csrf_cookie=xxx; sid=xxx
KONTER_COOKIE=

# Hanya chat id Telegram ini yang boleh memakai perintah sensitif
# (/saldo, /riwayat, /order). Kosongkan berarti semua chat boleh (TIDAK disarankan).
ALLOWED_CHAT_IDS=

# URL base situs
KONTER_BASE_URL=https://konterkuota.com
